---
layout: layouts/base.njk
permalink: /index.html
isHome: true
bodyClass: home-page
title: MAI Unstoppable
description: 关于一人公司、AI Agent、真实项目与长期创作的现场记录。
---
{% set leadArticle = collections.publishedArticles[0] %}
<section class="home-hero" aria-labelledby="hero-title">
  <div class="home-hero__topline">
    <div class="issue-label">{% if leadArticle %}{{ leadArticle.data.kicker or "Latest story" }}{% else %}MAI Unstoppable{% endif %}</div>
    {% if leadArticle %}<time datetime="{{ leadArticle.data.publishedAt | isoDate }}">{{ leadArticle.data.publishedAt | displayDate(leadArticle.data.lang) }}</time>{% endif %}
  </div>
  <div class="home-hero__copy">
    {% if leadArticle %}
    <h1 id="hero-title">{{ leadArticle.data.title }}</h1>
    <a class="hero-link" href="{{ leadArticle.url }}">阅读全文 <span aria-hidden="true">→</span></a>
    {% else %}
    <h1 id="hero-title">麥客不停，创作不止。</h1>
    {% endif %}
  </div>
  <div class="home-hero__details">
    <p class="hero-deck">{% if leadArticle %}{{ leadArticle.data.description }}{% else %}关于一人公司、AI Agent、真实项目与长期创作的现场记录。{% endif %}</p>
    {% if leadArticle %}<p class="hero-format">{{ leadArticle.data.readingMinutes | readingLabel }}<br>{{ leadArticle.data.lang }}</p>{% endif %}
  </div>
</section>

<section class="shell story-section" id="stories" aria-labelledby="latest-title">
  <header class="section-heading">
    <h2 id="latest-title">最近的长篇记录</h2>
    <div><div class="section-label">Latest stories</div><p>完整上下文 · 清楚的修订时间</p></div>
  </header>
  <div class="story-list">
    {% for article in collections.publishedArticles | limit(3) %}
    <a class="story-row{% if loop.first %} story-row--featured{% endif %}" href="{{ article.url }}">
      <span class="story-index">{{ loop.index }}</span>
      <div class="story-copy"><h3>{{ article.data.title }}</h3><p>{{ article.data.description }}</p></div>
      <span class="story-meta"><time datetime="{{ article.data.publishedAt | isoDate }}">{{ article.data.publishedAt | displayDate(article.data.lang) }}</time><span>{{ article.data.readingMinutes | readingLabel }}</span></span>
      <span class="story-arrow" aria-hidden="true">→</span>
    </a>
    {% else %}
    <p class="empty-state">第一篇长文正在整理中。</p>
    {% endfor %}
  </div>
</section>

<section class="shell series-section" id="series" aria-labelledby="series-title">
  <header class="section-heading series-heading">
    <h2 id="series-title">持续进行的项目</h2>
    <div><div class="section-label">Ongoing series</div><p>从真实项目里长出来的长期记录</p></div>
  </header>
  {% set featuredSeries = series[0] %}
  <a class="series-feature" href="{{ featuredSeries.url }}">
    <span class="series-feature__art" aria-hidden="true"><span>01</span></span>
    <span class="series-feature__copy">
      <span class="section-label">Field series · {{ featuredSeries.status }}</span>
      <strong>{{ featuredSeries.title }}</strong>
      <span>{{ featuredSeries.description }}</span>
      <span class="series-feature__link">查看系列目录 →</span>
    </span>
  </a>
</section>
